{
  "expo": {
    "name": "Vibloo",
    "slug": "vibloo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vibloo.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1d6b60",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.vibloo.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "vibloo",
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Vibloo usa il microfono per registrare i messaggi vocali."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Vibloo usa le tue foto solo per inviarle nelle chat.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
